diff --git a/common/cpu.c b/common/cpu.c
index acf4fec5..266edcdb 100644
--- a/common/cpu.c
+++ b/common/cpu.c
@@ -471,10 +471,11 @@ int x264_cpu_num_processors( void )
 
 #else
     /*
-     * ffmpeg.wasm: manually set the number of 
-     * processor as it cannot be detected in 
-     * emscripten environment.
+     * ffmpeg.wasm: modern emscripten reports the real core count via
+     * sysconf (navigator.hardwareConcurrency); the historical
+     * hardcoded 4 remains the fallback if detection fails.
      */
-    return 4;
+    long ncpu = sysconf( _SC_NPROCESSORS_ONLN );
+    return ncpu > 0 ? (int)ncpu : 4;
 #endif
 }
