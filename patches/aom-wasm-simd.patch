diff --git a/aom_dsp/x86/sad_wasm_sse2.c b/aom_dsp/x86/sad_wasm_sse2.c
new file mode 100644
index 000000000..5a9d2fe34
--- /dev/null
+++ b/aom_dsp/x86/sad_wasm_sse2.c
@@ -0,0 +1,116 @@
+/*
+ * wasm-simd port: SSE2-intrinsic SAD kernels for block widths <= 16.
+ *
+ * Upstream implements these in nasm assembly (sad_sse2.asm /
+ * sad4d_sse2.asm), which cannot target WebAssembly. The wider sizes
+ * (>= 32) are covered by the AVX2 intrinsics; these fill the gap so
+ * motion estimation's hottest loop runs as wasm simd128 instead of
+ * scalar C. All results are exact integer sums — bit-identical to the
+ * C reference.
+ */
+
+#include <emmintrin.h>
+#include <string.h>
+
+#include "config/aom_config.h"
+#include "aom/aom_integer.h"
+
+static inline __m128i load_row(const uint8_t *p, int width) {
+  if (width == 16) return _mm_loadu_si128((const __m128i *)p);
+  if (width == 8) return _mm_loadl_epi64((const __m128i *)p);
+  // width == 4: 32-bit load into the low lane, upper lanes zeroed
+  uint32_t v;
+  memcpy(&v, p, 4);
+  return _mm_cvtsi32_si128((int)v);
+}
+
+static inline unsigned int sad_wxh(const uint8_t *src, int ss,
+                                   const uint8_t *ref, int rs, int width,
+                                   int height) {
+  __m128i acc = _mm_setzero_si128();
+  for (int y = 0; y < height; y++) {
+    const __m128i s = load_row(src, width);
+    const __m128i r = load_row(ref, width);
+    acc = _mm_add_epi64(acc, _mm_sad_epu8(s, r));
+    src += ss;
+    ref += rs;
+  }
+  return (unsigned int)(_mm_cvtsi128_si32(acc) +
+                        _mm_cvtsi128_si32(_mm_srli_si128(acc, 8)));
+}
+
+static inline unsigned int sad_avg_wxh(const uint8_t *src, int ss,
+                                       const uint8_t *ref, int rs,
+                                       const uint8_t *pred, int width,
+                                       int height) {
+  __m128i acc = _mm_setzero_si128();
+  for (int y = 0; y < height; y++) {
+    const __m128i s = load_row(src, width);
+    // comp pred = ROUND_POWER_OF_TWO(ref + pred, 1) == pavgb, exact
+    const __m128i r = _mm_avg_epu8(load_row(ref, width), load_row(pred, width));
+    acc = _mm_add_epi64(acc, _mm_sad_epu8(s, r));
+    src += ss;
+    ref += rs;
+    pred += width;
+  }
+  return (unsigned int)(_mm_cvtsi128_si32(acc) +
+                        _mm_cvtsi128_si32(_mm_srli_si128(acc, 8)));
+}
+
+#define SAD_FUNCS(w, h)                                                       \
+  unsigned int aom_sad##w##x##h##_sse2(const uint8_t *src, int src_stride,    \
+                                       const uint8_t *ref, int ref_stride) {  \
+    return sad_wxh(src, src_stride, ref, ref_stride, w, h);                   \
+  }                                                                           \
+  unsigned int aom_sad##w##x##h##_avg_sse2(                                   \
+      const uint8_t *src, int src_stride, const uint8_t *ref,                 \
+      int ref_stride, const uint8_t *second_pred) {                           \
+    return sad_avg_wxh(src, src_stride, ref, ref_stride, second_pred, w, h);  \
+  }                                                                           \
+  void aom_sad##w##x##h##x4d_sse2(const uint8_t *src, int src_stride,         \
+                                  const uint8_t *const ref[4],                \
+                                  int ref_stride, uint32_t res[4]) {          \
+    for (int i = 0; i < 4; i++)                                               \
+      res[i] = sad_wxh(src, src_stride, ref[i], ref_stride, w, h);            \
+  }                                                                           \
+  void aom_sad##w##x##h##x3d_sse2(const uint8_t *src, int src_stride,         \
+                                  const uint8_t *const ref[4],                \
+                                  int ref_stride, uint32_t res[4]) {          \
+    for (int i = 0; i < 3; i++)                                               \
+      res[i] = sad_wxh(src, src_stride, ref[i], ref_stride, w, h);            \
+  }
+
+// skip variants: SAD over even rows only, doubled — defined for h >= 16
+#define SAD_SKIP_FUNCS(w, h)                                                  \
+  unsigned int aom_sad_skip_##w##x##h##_sse2(                                 \
+      const uint8_t *src, int src_stride, const uint8_t *ref,                 \
+      int ref_stride) {                                                       \
+    return 2 * sad_wxh(src, 2 * src_stride, ref, 2 * ref_stride, w, (h) / 2); \
+  }                                                                           \
+  void aom_sad_skip_##w##x##h##x4d_sse2(const uint8_t *src, int src_stride,   \
+                                        const uint8_t *const ref[4],          \
+                                        int ref_stride, uint32_t res[4]) {    \
+    for (int i = 0; i < 4; i++)                                               \
+      res[i] = 2 * sad_wxh(src, 2 * src_stride, ref[i], 2 * ref_stride, w,    \
+                           (h) / 2);                                          \
+  }
+
+SAD_FUNCS(4, 4)
+SAD_FUNCS(4, 8)
+SAD_FUNCS(4, 16)
+SAD_FUNCS(8, 4)
+SAD_FUNCS(8, 8)
+SAD_FUNCS(8, 16)
+SAD_FUNCS(8, 32)
+SAD_FUNCS(16, 4)
+SAD_FUNCS(16, 8)
+SAD_FUNCS(16, 16)
+SAD_FUNCS(16, 32)
+SAD_FUNCS(16, 64)
+
+SAD_SKIP_FUNCS(4, 16)
+SAD_SKIP_FUNCS(8, 16)
+SAD_SKIP_FUNCS(8, 32)
+SAD_SKIP_FUNCS(16, 16)
+SAD_SKIP_FUNCS(16, 32)
+SAD_SKIP_FUNCS(16, 64)
